char    texture[64];
uint16  tile_count;
uint8   padding[14];

typedef enum <uint8>
{
    False,
    True
} boolean;

struct
{    
    struct
    {
        uint16 x;
        uint16 y;
    } position;
    
    struct
    {
        uint8 x;
        uint8 y;    
    } size;
    
    boolean has_collision;
    uint8   padding;
} tiles[tile_count];