char    texture[64];
uint16  tile_count;
uint8   padding[14];

struct
{    
    uint16  texture_x;
    uint16  texture_y;
    uint8   texture_w;
    uint8   texture_h;
    enum    <uint8> {None=0, Box=1} coll_type;
    enum    <uint8> {False=0, True=1} is_sorted;
} tiles[tile_count];