struct ATLAS
{
    char    texture[64];
    uint16  tile_count;
    char    padding[14];
    struct  TILE
    {
        uint16  texture_x;
        uint16  texture_y;
        uint16  texture_w;
        uint16  texture_h;
    } tiles[tile_count];
} atlas;