//------------------------------------------------

char    atlas[64];
int16  chunk_count;
uint8   padding[14];

struct
{    
    int8 x;
    int8 y;
} position_data[chunk_count];

struct
{
    struct
    {
        uint16 atlas_index;
	    int8 z;
	    uint8 flip_x : 1;
	    uint8 flip_y : 1;
	    uint8 rotate_ccw : 1;
	    uint8 additional_flags : 5;    
    } tiles[512];
} tile_data[chunk_count];

struct
{
    struct
    {
        uint16 type;
        int8 x;
        int8 y;  
        uint8 data[12];
    } objects[64];
} object_data[chunk_count];